---
import '../main.css';
import type { MarkdownLayoutProps } from 'astro';

type Props = MarkdownLayoutProps<{ readonly title: string }>;

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang='ja'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <meta name='color-scheme' content='light dark' />
    <link type='icon' href='/favicon.ico' />
    <meta name='generator' content={Astro.generator} />

    <!-- fonts -->
    <link
      rel='preload'
      as='font'
      href='https://api.tktb-tess.dev/fonts/Inter/InterVariable.woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      as='font'
      href='https://api.tktb-tess.dev/fonts/Inter/InterVariable-Italic.woff2'
      crossorigin='anonymous'
    />
    <!-- font-face -->
    <link
      rel='stylesheet'
      href='https://api.tktb-tess.dev/fonts/Inter/font-face.css'
      crossorigin='anonymous'
    />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <header>
      <h1 id='title'>
        {frontmatter.title}
      </h1>
    </header>
    <main>
      <p class='__back-link'>
        <a href='/.'>戻る</a>
      </p>
      <div class='__md-root'>
        <slot />
      </div>
    </main>
  </body>
</html>

<style lang="postcss">
  @reference '../main.css';

  @layer components {
    body {
      @apply max-xl:flow-root xl:grid bg-side text-text;

      grid-template-areas:
        'h h h'
        '. m .'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 100%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 100%), 1fr);

      grid-template-rows: auto 1fr auto;
    }

    header,
    main,
    footer {
      @apply flow-root;
    }

    header {
      grid-area: h;
    }

    main {
      @apply px-4 pbe-36 bg-main min-block-lvh;
      grid-area: m;
    }

    footer {
      grid-area: f;
    }

    #title {
      @apply max-sm:text-4xl sm:text-5xl font-extralight font-title 
        text-balance my-title-mb text-center;
    }

    .__back-link {
      @apply my-6 ms-1;
    }
  }
</style>
